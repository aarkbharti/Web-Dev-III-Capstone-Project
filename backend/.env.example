NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/parkeasy
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# Used only by "npm run seed" to create the first admin
ADMIN_EMAIL=admin@parkeasy.com
ADMIN_PASSWORD=Admin@123
